{
  "name": "dsh-kitt-voice",
  "version": "0.1.1",
  "description": "DSH KITT — Spanish-first voice for the DeepSeek Harness web UI: hands-free conversation, push-to-talk (Whisper), read-aloud replies, and a floating overlay window with global hotkeys. · DSH KITT 语音：为 DeepSeek Harness 打造的语音插件——免提对话、按键说话（Whisper）、朗读回复，以及带全局快捷键的悬浮窗；界面支持中文、英文和西班牙语。",
  "type": "module",
  "license": "MIT",
  "author": {
    "name": "Kitt Cat"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kittcat-lab/dsh-kitt-voice.git"
  },
  "homepage": "https://github.com/kittcat-lab/dsh-kitt-voice#readme",
  "bugs": {
    "url": "https://github.com/kittcat-lab/dsh-kitt-voice/issues"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-conversation"
      ],
      "platform": "web"
    }
  },
  "files": [
    "lib",
    "overlay",
    "!overlay/abrir.local.cmd",
    "!overlay/brand/marks.*.js",
    "cordis.patch.yml",
    "README.md",
    "README.es.md",
    "README.zh.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "LICENSE",
    "NOTICE"
  ],
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "voice",
    "speech",
    "stt",
    "tts",
    "whisper",
    "piper",
    "spanish",
    "espanol",
    "chinese",
    "electron"
  ],
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1",
    "msedge-tts": "^2.0.7"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-web": "^0.1.0-rc.6 || ^0.1.1-rc.0",
    "react": "^18.2.0"
  },
  "scripts": {
    "test": "node --test test/guard.test.js test/speak.test.js test/chunk.test.js test/lastfromlog.test.js test/frases.test.js test/requests.test.js test/paraleer.test.js test/velocidad.test.js"
  }
}
